    header {
      background: #2c3e50;
      color: white;
      text-align: center;
      padding: 40px 20px;
    }
    nav a {
      color: #ecf0f1;
      margin: 0 12px;
      text-decoration: none;
    }
    nav a:hover { text-decoration: underline; }
    main {
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
    }
    section { margin-bottom: 40px; }
    h2 { border-bottom: 2px solid #2c3e50; padding-bottom: 6px; }
    img { max-width: 100%; border-radius: 8px; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
    th { background: #f2f2f2; }
    footer {
      background: #2c3e50;
      color: white;
      text-align: center;
      padding: 15px;
    }
