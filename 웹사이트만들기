      <form>
        <p>
          <label for="name">이름:</label><br>
          <input type="text" id="name" name="name">
        </p>
        <p>
          <label for="msg">메시지:</label><br>
          <textarea id="msg" name="msg" rows="4" cols="40"></textarea>
        </p>
        <button type="submit">보내기</button>
